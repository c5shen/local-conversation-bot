# Copy to .env and adjust as needed. All values have sane defaults in server/config.py.

# --- Orchestrator HTTP server ---
HOST=127.0.0.1
PORT=8080

# --- Speech-to-text (whisper.cpp whisper-server) ---
WHISPER_URL=http://127.0.0.1:8081
STT_SAMPLE_RATE=16000

# --- LLM (llama.cpp llama-server, OpenAI-compatible) ---
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_MODEL_TYPE=oai
LLM_API_KEY=EMPTY
TEMPERATURE=0.7
TOP_P=0.8
MAX_TOKENS=32768
# Prompt-token budget for Qwen-Agent. 0 = auto (fill the llama-server context,
# leaving room for the reply). Set a number to cap it for lower latency.
MAX_INPUT_TOKENS=0

# --- Text-to-speech ---
# Engine loaded at startup; switchable live from the UI. "kokoro" (small/fast,
# default) or "qwen" (Qwen3-TTS CustomVoice, higher quality but heavier/slower).
TTS_ENGINE=kokoro
# Qwen engine weights (only used when the Qwen engine is active).
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_LANGUAGE=English
TTS_VOICE=Ryan
TTS_SAMPLE_RATE=24000
TTS_DEVICE=cuda
# Attention impl: "sdpa" (default, no extra deps) or "flash_attention_2" (needs flash-attn).
TTS_ATTN=sdpa
FILLER_TEXT=Let me look that up.

# --- Agent / tools (Tavily web search + extract; https://tavily.com) ---
ENABLE_SEARCH=true
# Get a key at https://app.tavily.com. Search is disabled if this is empty.
TAVILY_API_KEY=
# "basic" (fast/cheap) or "advanced" (deeper, higher latency + cost).
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
# Include Tavily's short LLM-generated answer alongside the raw results.
TAVILY_INCLUDE_ANSWER=true
